# Environment Variables for Ravie Website
# Copy this file to .env.local and update with your values

# Core Configuration
NODE_ENV=development

# Security Configuration
# CSP violation report endpoint (optional)
VITE_CSP_REPORT_URI=

# Comma-separated list of allowed CORS origins (optional)
# Default: https://ravie.co,https://www.ravie.co
VITE_ALLOWED_ORIGINS=

# Rate Limiting (optional)
# Maximum requests per window
VITE_RATE_LIMIT_MAX_REQUESTS=100

# Rate limit window in milliseconds (15 minutes = 900000)
VITE_RATE_LIMIT_WINDOW_MS=900000

# API Configuration (optional)
VITE_API_URL=

# Analytics (optional)
VITE_ANALYTICS_ID=